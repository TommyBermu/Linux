{
    "appearance": {
        "transparency": {
            "enabled": true
        }
    },
    "background": {
        "wallpaperEnabled": true
    },
    "bar": {
        "activeWindow": {
            "compact": false,
            "inverted": false,
            "showOnHover": true
        },
        "clock": {
            "background": true,
            "showDate": true
        },
        "persistent": false,
        "popouts": {
            "activeWindow": true,
            "tray": true
        },
        "showOnHover": true,
        "status": {
            "showAudio": false,
            "showKbLayout": true,
            "showLockStatus": true
        },
        "tray": {
            "background": false,
            "compact": false,
            "recolour": false
        },
        "workspaces": {
            "activeIndicator": true,
            "activeTrail": false,
            "maxWindowIcons": 4,
            "occupiedBg": false,
            "perMonitorWorkspaces": true,
            "showWindows": true,
            "showWindowsOnSpecialWorkspaces": true,
            "shown": 4
        }
    },
    "dashboard": {
        "dragThreshold": 20,
        "showOnHover": false,
        "showPerformance": true,
        "showWeather": true
    },
    "general": {
        "apps": {
            "explorer": [
                "dolphin"
            ],
            "terminal": [
                "kitty"
            ]
        }
    },
    "launcher": {
        "enabled": true,
        "maxShown": 8,
        "maxWallpapers": 8,
        "showOnHover": false,
        "vimKeybinds": true
    },
    "services": {
        "defaultPlayer": "Brave",
        "useFahrenheit": false,
        "useTwelveHourClock": false
    },
    "sidebar": {
        "dragThreshold": 30,
        "enabled": true
    }
}
