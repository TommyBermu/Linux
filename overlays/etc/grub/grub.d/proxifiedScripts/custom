	echo	'Loading initial ramdisk ...'
	initrd	/amd-ucode.img /initramfs-linux-cachyos-hardened.img
}
menuentry "BlackArch-hardened" --class arch --class gnu-linux --class gnu --class os $menuentry_id_option 'gnulinux-linux-hardened-advanced-80ddb64f-cf0c-458e-a87c-605d151b617e' {
